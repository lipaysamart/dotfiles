{
  "lastChangelogVersion": "0.84.4",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4-flash",
  "subagents": {
    "agentOverrides": {
      "reviewer": {
        "model": "opencode-go/glm-5.2",
        "thinking": "high",
        "fallbackModels": []
      },
      "oracle": {
        "model": "opencode-go/glm-5.2",
        "thinking": "high",
        "fallbackModels": []
      },
      "planner": {
        "model": "opencode-go/kimi-k3",
        "thinking": "high",
        "fallbackModels": []
      },
      "researcher": {
        "model": "opencode-go/kimi-k2.6",
        "thinking": "medium",
        "fallbackModels": []
      },
      "worker": {
        "model": "opencode-go/deepseek-v4-flash",
        "thinking": "max",
        "fallbackModels": []
      },
      "scout": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallbackModels": []
      }
    }
  },
  "packages": [
    "pi-skills",
    "npm:pi-subagents@0.62.0",
    "npm:pi-web-access@0.22.0",
    "npm:pi-intercom@0.6.0",
    "npm:pi-powerline-footer@0.7.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.1.0",
    "npm:@juicesharp/rpiv-todo@2.1.0",
    "npm:pi-prompt-template-model@0.12.0",
    "npm:pi-side-chat@0.1.4"
  ],
  "enableSkillCommands": true,
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "skills": [
    "~/.agents/skills"
  ],
  "prompts": [
    "~/.agents/commands"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "defaultThinkingLevel": "max",
  "powerline": {
    "preset": "default",
    "fixedEditor": false,
    "customItems": [],
    "mouseScroll": false
  },
  "bashMode": {
    "toggleShortcut": "ctrl+shift+b",
    "transcriptMaxLines": 2000,
    "transcriptMaxBytes": 524288
  },
  "workingVibe": "star trek",
  "workingVibeMode": "file",
  "workingVibeModel": "opencode-go/deepseek-v4-flash",
  "workingVibeFallback": "Working",
  "workingVibeRefreshInterval": 30,
  "workingVibeMaxLength": 65,
  "enabledModels": [
    "opencode-go/kimi-k2.6",
    "opencode-go/kimi-k2.7-code",
    "opencode-go/kimi-k3",
    "opencode-go/deepseek-v4-flash",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "metis/metis-coder",
    "opencode-go/deepseek-v4-flash-vision-exp"
  ],
  "theme": "dark",
  "hideThinkingBlock": true
}
