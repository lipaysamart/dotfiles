{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",

  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": true,
  "doublePressToConfirm": false,
  "forwardingTimeoutMs": 600000,
  "toolInputPreviewMaxLength": 400,
  "toolTextSummaryMaxLength": 120,
  "piInfrastructureReadPaths": [],

  "shellTools": {
    "hypa_shell": { "commandArgument": "hypa" }
  },

  "permission": {
    "*": "allow", 
    "path": {
      "*": "allow",
      "~/.ssh/*": "deny"
    },

    "read": {
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.aliyun/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.git-credentials": "deny",
      "~/.docker/config.json": "deny",
      "~/.kube/*": "deny",
      "~/.npmrc": "deny",
      "~/.npm/*": "deny",
      "~/.pypirc": "deny",
      "~/.gem/credentials": "deny",
      "~/Library/Keychains/*": "deny"
    },

    "edit": {
      "~/.bashrc": "deny",
      "~/.zshrc": "deny",
      "~/.zshrc.local": "deny"
    },

    "bash": {
      "git push --force *": "deny",
      "wget * | bash *": "deny",
      "git push * --force *": "deny",
      "git reset --hard *": "deny",
      "rm -rf *": "deny",
      "mkfs *": "deny",
      "dd *": "deny"
    },

    "external_directory": {
      "*": "allow",
      "/tmp/*": "allow",
      "~/Code/*": "allow"
    }
  }
}
